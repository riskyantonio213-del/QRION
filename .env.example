# Environment variables (all optional — the site runs fully without them)

# Public site URL, used for metadata, canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://qrion.example.com

# Customer portal / app login. When empty, the navbar "Masuk" button renders as a
# disabled control instead of a broken link.
NEXT_PUBLIC_LOGIN_URL=

# Public contact channels. Left empty, safe placeholders are shown and clearly
# labelled in the UI.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Official social accounts. Empty values render as disabled icons (no dead links).
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# ---------------------------------------------------------------------------
# CRM / EMAIL INTEGRATION (server-only — never exposed to the browser)
# Contact + demo form submissions are POSTed to this endpoint as JSON:
#   { source, kind: "kontak" | "demo", receivedAt, payload }
# Point it at a CRM, automation platform, or your own API route.
# ---------------------------------------------------------------------------
QRION_CRM_WEBHOOK_URL=
QRION_CRM_WEBHOOK_TOKEN=
# Optional: shown to visitors as a fallback when delivery is unavailable.
QRION_FORM_FALLBACK_EMAIL=
